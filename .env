# Defaults for local development. Committed on purpose: contains no secrets.
# Real values go to .env.local (git-ignored) or to real environment variables.
# Production: see .env.prod.example.

APP_ENV=dev
APP_SECRET=change-me-in-env-local

# Postgres from compose.yaml (service "database", published on 127.0.0.1:5432).
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?serverVersion=17&charset=utf8"

# JWT signing keys, generate with: make jwt-keys
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dev-only-passphrase

# Lifetimes in seconds: access token 15 minutes, refresh token 30 days.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Comma separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-*.
# Empty = trust none (correct when the app is reached directly).
TRUSTED_PROXIES=
